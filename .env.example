# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VOIX IA — VOICESTUDIO (https://github.com/debpalash/voicestudio) + NEURAL FR
# VOICE_ENGINE: auto | voicestudio | edge_neural | elevenlabs
# En mode auto, utilise VoiceStudio si VOICESTUDIO_URL est joignable, sinon Edge Neural FR gratuit sans quota.
VOICE_ENGINE="auto"
VOICESTUDIO_URL="http://127.0.0.1:8787"
VOICESTUDIO_API_KEY=""
# Moteurs VoiceStudio : omnivoice | voxcpm2 | cosyvoice | kittentts | moss-tts-nano
VOICESTUDIO_MODEL="omnivoice"
# ID ou nom du profil vocal (cloné ou designer) dans VoiceStudio, ou "default"
VOICESTUDIO_VOICE="default"
VOICESTUDIO_LANGUAGE="fr"
VOICESTUDIO_INSTRUCT="Voix masculine française claire, posée, naturelle et dynamique pour Short YouTube."
# Voix neurale intégrée sans quota quand VoiceStudio local n'est pas lancé
EDGE_TTS_VOICE="fr-FR-RemyMultilingualNeural"

# ELEVENLABS_API_KEY: Optionnel (utilisé uniquement si VOICE_ENGINE=elevenlabs).
ELEVENLABS_API_KEY=""

# OAUTH RÉSEAUX SOCIAUX (Publication automatique directe)
# Callback YouTube : ${APP_URL}/api/social/oauth/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Callback Instagram (Meta Graph API) : ${APP_URL}/api/social/oauth/instagram/callback
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Callback TikTok (Content Posting API v2) : ${APP_URL}/api/social/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# PASSERELLE TREG (Connexion 1-lien pour YouTube, Instagram, TikTok sans console développeur)
# Optionnel : peut aussi être connecté directement depuis l'interface ("Se connecter à Treg en 1 lien")
TREG_TOKEN=""
TREG_ORG=""

# HÉBERGEMENT 24/7 & STOCKAGE PERSISTANT (Railway / Render / Fly.io)
STORAGE_DIR="/app/storage"
ALWAYS_ON_SERVER="true"
# Optionnel : protège POST /api/social/cron-tick pour les crons externes (GitHub Actions)
CRON_SECRET=""

# SYNCHRONISATION 3-VOIES (Studio <-> GitHub <-> Railway)
# Dépôt GitHub cible pour le push automatique des projets & vidéos (ex: owner/repo)
GITHUB_REPO=""
# Token GitHub personnel (PAT) stocké uniquement dans .env / variables Railway (jamais commité)
GITHUB_TOKEN=""
# URL publique du serveur Railway 24/7 pour synchronisation directe sans attendre rebuild
RAILWAY_STUDIO_URL=""
# Secret partagé optionnel entre local et Railway pour sécuriser /api/sync/*
SYNC_SECRET=""
