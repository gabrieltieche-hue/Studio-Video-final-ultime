# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Required for French voiceover generation & /api/tts proxy.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"
# Optional: defaults automatically in server.ts/voiceover.mjs to Brian (nPczCjzI2devNBz1zQrb, Deep Baritone Free Plan premade API voice).
# ELEVENLABS_VOICE_ID="nPczCjzI2devNBz1zQrb"

# OAUTH RÉSEAUX SOCIAUX (Publication automatique directe)
# Callback YouTube : ${APP_URL}/api/social/oauth/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Callback Instagram (Meta Graph API) : ${APP_URL}/api/social/oauth/instagram/callback
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Callback TikTok (Content Posting API v2) : ${APP_URL}/api/social/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

