{
  "version": 1,
  "name": "Papier Signature",
  "creator": {
    "name": "Studio Short FR",
    "handle": "@alex.decode",
    "handleIsPlaceholder": true,
    "lang": "fr",
    "voiceProvider": "elevenlabs",
    "voiceId": "nPczCjzI2devNBz1zQrb",
    "voiceName": "Brian — Deep, Resonant Baritone (Free Plan)"
  },
  "colors": {
    "paper": "#F1EEE6",
    "sheet": "#FCFBF8",
    "ink": "#14161B",
    "ink2": "#5C5F68",
    "ink3": "#A19F98",
    "line": "#E3DED3",
    "accent": "#258EFF",
    "onAccent": "#FFFFFF"
  },
  "captions": {
    "style": "rise",
    "groupedContainer": true,
    "perWordBoxes": false,
    "size": 70,
    "maxWords": 4,
    "maxChars": 24,
    "straddle": true
  },
  "layout": {
    "frame": { "bleed": true, "r": 32, "border": 0, "shadow": 40 },
    "seam": 1160,
    "highMotionDensity": true,
    "noBlankPaper": true,
    "topProgressChrome": false,
    "ambientBlueOrbs": true,
    "noLowerFullPaperVoid": true
  },
  "display": {
    "font": "Bricolage Grotesque",
    "weight": 800,
    "flat": true
  },
  "pace": {
    "speed": 1.06,
    "targetDurationSec": [45, 55],
    "tighten": { "sentence": 0.08, "comma": 0.05, "word": 0.03 }
  },
  "music": {
    "bed": "upbeat",
    "src": "assets/music/upbeat.mp3",
    "offset": 0
  },
  "mix": {
    "music": -12.5,
    "musicGain": 0.24,
    "soloMusicGain": 0.36,
    "sfx": -15,
    "duck": 0.65
  },
  "cta": {
    "type": "subscribe",
    "label": "Abonne-toi pour ne rien rater des prochains décryptages tech"
  },
  "qa": {
    "visualStoryboard": true,
    "audioClockSync": true,
    "singleCaptionContainer": true,
    "preRenderMp4ToDisk": true
  },
  "sfx": {
    "swish": 0,
    "accents": 0
  }
}
